{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openmirror",
  "version": "0.1.0",
  "identifier": "dev.openmirror.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "An open-source digital twin",
    "longDescription": "openmirror is an open-source digital twin: it runs on your machine with shell and file access, a real browser, desktop control, live voice, opt-in memory, and a choice of model provider for every kind of generation."
  }
}
