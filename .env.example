# Roost — everything here is optional. A provider with no key is simply not
# registered, so an install with only Perch configured is a complete install.

# --- server ---------------------------------------------------------------
ROOST_HOST=127.0.0.1
ROOST_PORT=8477
# Required if you move off loopback. This process runs commands on the machine.
ROOST_TOKEN=

# The only directory an agent session may read or write. Confinement is the
# one thing between a model and the rest of your disk, so keep it narrow.
ROOST_WORKSPACE=/home/you/code/project

# read_only | ask | auto_edit | trusted | unrestricted
ROOST_APPROVAL_MODE=ask

# Give the agent the whole filesystem rather than confining it to the
# workspace. With this off, the file tools refuse paths outside the root and
# the shell escalates any command that names one — the shell cannot actually
# be confined, so the best it can do is stop and ask.
ROOST_UNCONFINED=false

# Money and secrets are a separate axis from ROOST_APPROVAL_MODE, on purpose:
# `unrestricted` means "stop asking me about this machine", which is not the
# same sentence as "spend my money". No approval mode auto-runs a purchase
# unless this is on.
ROOST_ALLOW_PURCHASES=false
# Leave this off. With it off, the browser hands password, card and one-time
# code fields to you instead — so the agent never has the value in its context
# or its transcript at all. Approving it to type your password is worse.
ROOST_ALLOW_CREDENTIALS=false

# --- the web ---------------------------------------------------------------
ROOST_WEB=true
# Letting it fetch loopback and link-local addresses would let a page it is
# reading reach things never exposed to the internet — a cloud metadata
# endpoint, or Perch's own console.
ROOST_WEB_ALLOW_PRIVATE=false

# brave | tavily | searxng | duckduckgo
# The keyless duckduckgo fallback is blocked in practice — it answers
# automated requests with an anomaly page — so set a real one.
ROOST_SEARCH_BACKEND=duckduckgo
ROOST_SEARCH_KEY=
ROOST_SEARCH_URL=

# --- the desktop -----------------------------------------------------------
# Screenshot the screen and drive the mouse and keyboard. Off by default: it
# is the widest capability here and has the weakest safety net, because a
# click on a bitmap cannot be graded the way a click on a labelled DOM element
# can. Prefer the browser for anything that can be done in a browser.
ROOST_DESKTOP=false

# Where that happens, and it is the setting that decides whether you can keep
# using your computer while it works.
#
#   virtual  an X server of its own — its own pointer, its own keyboard, its
#            own windows. Applications are launched onto it by environment and
#            you watch through the frames it captures. This is the only
#            setting under which "it will not take your mouse" is a guarantee
#            rather than an intention. Needs Xvfb installed.
#   shared   the screen you are looking at. One pointer, and it moves it.
#   auto     virtual where it can, shared where it cannot, and it says which
#            in the log.
ROOST_DESKTOP_STAGE=auto
ROOST_DESKTOP_VIRTUAL_SIZE=1920x1080

# On a shared screen with more than one monitor, confine it to one. An index
# as X arranges them (1 is the first) or a name from xrandr. Everything
# outside that rectangle is neither captured nor clickable, and a coordinate
# outside it is refused rather than clamped — a clamped click lands on
# something real.
ROOST_DESKTOP_MONITOR=
ROOST_DESKTOP_DISPLAY=

# On a shared screen, stop the moment the pointer moves somewhere it was not
# left — which means a person has a hand on the mouse. The agent is told, and
# says so, rather than fighting for the cursor.
ROOST_DESKTOP_YIELD=true

# On Linux, a shared stage needs /dev/uinput writable on Wayland (add yourself
# to the "input" group) and libX11 and libXtst on X11. Wayland capture goes
# through the compositor's own screenshot tool — grim, cosmic-screenshot,
# gnome-screenshot or spectacle — because X11 grabbers return a black image
# there. macOS needs Screen Recording and Accessibility permission.

# --- the browser -----------------------------------------------------------
# Needs: pip install playwright && playwright install chromium
ROOST_BROWSER=false
# A real profile directory. Sign in to your sites here once, by hand; the
# agent inherits the sessions and never needs a password.
ROOST_BROWSER_PROFILE=~/.roost/browser
# Headful is worth it for anything transactional — you can watch it work and
# take the mouse off it.
ROOST_BROWSER_HEADLESS=true

# --- Perch: one host, one token, five services -----------------------------
# Roost probes 11434 (Ollama), 8080 (whisper), 7860 (SD), 8188 (ComfyUI) and
# 8880 (Kokoro) and registers whichever answer as Perch,
# so a Perch with only chat switched on registers only chat.
PERCH_HOST=127.0.0.1
PERCH_TOKEN=
PERCH_SCHEME=http

# --- other providers -------------------------------------------------------
# These are the ones that can be set from the environment. Everything else —
# Groq, OpenRouter, Fireworks, Together, NanoGPT, DeepInfra, Cerebras,
# Mistral, xAI, Voyage, Google, LM Studio, vLLM, llama.cpp — is added from the
# Connections screen at runtime and kept in ROOST_CONNECTIONS below, so it can
# be changed without restarting a daemon that is in the middle of something.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# Keys the Connections screen will pick up if you have already set them, so
# connecting a service you were already configured for does not mean finding
# the key again.
GROQ_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
NANOGPT_API_KEY=
DEEPINFRA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# --- Tor -------------------------------------------------------------------
# Opt in per connection, from the Connections screen — never inferred from the
# proxy being up, because that would be a decision about where your prompts go
# made on your behalf. Needs: pip install "roost[tor]"
#
# Where the SOCKS proxy is. 9150 is Arti's default; the older C tor daemon
# uses 9050, and a failed probe checks for it and says so rather than
# reporting that nothing is listening.
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9150

# Open WebUI is itself a provider: it serves OpenAI's shapes at /api/v1, so
# pointing at it exposes every connection configured over there.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=

# --- defaults --------------------------------------------------------------
ROOST_CHAT_MODEL=
ROOST_STT_MODEL=whisper-1
ROOST_TTS_MODEL=tts-1
ROOST_TTS_VOICE=alloy

# Refuse every provider that is not local hardware. Enforced when a route is
# resolved, not merely hidden in a UI: with it on, a local backend being down
# is an error rather than a quiet fallback to a hosted one.
ROOST_LOCAL_ONLY=false

# Which connection answers, per kind of request. Chat and embedding are named
# separately and deliberately: your questions go to one and your entire
# remembered history goes to the other, and a single "AI provider" setting is
# how someone ends up sending their memory to a vendor they picked for chat.
# Blank means "first provider that can", which prefers local hardware.
ROOST_CHAT_PROVIDER=
ROOST_EMBED_PROVIDER=

# Per-user vector memory. Two switches and both must be on: this one decides
# whether the feature exists on this install at all (off means the store is
# never even opened), and each person then opts in for themselves in the UI.
ROOST_MEMORY=false
ROOST_MEMORY_DB=./data/memory.db
# Which model turns text into vectors. Any provider registered for embeddings
# will do — Perch's, OpenAI's text-embedding-3-large, Gemini Embedding 2,
# Voyage's voyage-3-large, or Qwen3-Embedding 8B or 4B on your own hardware.
ROOST_EMBED_MODEL=
# Ask a truncatable model for shorter vectors. Cannot be changed under an
# existing store: vectors of different lengths cannot be compared, so old
# memories become unsearchable rather than wrong. 0 leaves it to the model.
ROOST_EMBED_DIMENSIONS=0

# --- generated media -------------------------------------------------------
# Images and video are written here as a file plus a JSON sidecar holding the
# prompt, the seed and every setting — because a picture you cannot reproduce
# is a picture you cannot iterate on.
ROOST_MEDIA_DIR=./data/media
ROOST_IMAGE_TIMEOUT=600
ROOST_VIDEO_TIMEOUT=1800

# Where connections added from the UI are kept. Written 0600; it holds keys.
ROOST_CONNECTIONS=./data/connections.json

# --- the realtime voice API ------------------------------------------------
# OpenAI's speech-to-speech endpoint, used by Live mode. It is one vendor's
# service and cannot be pointed at local hardware — for a local voice call,
# ordinary Talk mode routes dictation, thinking and speech separately.
ROOST_REALTIME_MODEL=gpt-realtime
ROOST_REALTIME_VOICE=marin
# Until Roost has accounts of its own, everything belongs to one person.
ROOST_USER=local

ROOST_LOG_LEVEL=INFO
